@namespace Doodle.Components.Layout
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <strong>Doodle</strong>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/editor">
                <span class="bi bi-pencil-square" aria-hidden="true"></span> Write Entry
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/calendar">
                <span class="bi bi-calendar" aria-hidden="true"></span> Calendar
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard">
                <span class="bi bi-bar-chart" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/search">
                <span class="bi bi-search" aria-hidden="true"></span> Search & Filter
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/export">
                <span class="bi bi-file-earmark-arrow-up" aria-hidden="true"></span> Export
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/settings">
                <span class="bi bi-gear" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
    </nav>
</div>
