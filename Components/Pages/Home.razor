@page "/"
@namespace Doodle.Components.Pages
@using Doodle.ViewModels
@using Doodle.Services
@using Doodle.Components.Shared
@inject StreakViewModel StreakViewModel
@inject HomeViewModel HomeViewModel
@inject SecurityService SecurityService
@inject SessionService SessionService
@inject NavigationManager Navigation
@inject StreakService StreakService
@implements IAsyncDisposable

<PageTitle>Home - Doodle</PageTitle>

<div class="home-container">
    <h1>Welcome to Doodle</h1>
    <p class="lead">Your personal journaling companion</p>

    <!-- Streak Statistics -->
    <div class="streak-section">
        <h2>Your Journaling Streak</h2>
        @if (StreakViewModel.IsLoading)
        {
            <p>Loading statistics...</p>
        }
        else
        {
            <div class="streak-cards">
                <div class="streak-card">
                    <div class="streak-value">@StreakViewModel.TotalEntries</div>
                    <div class="streak-label">TOTAL ENTRIES</div>
                </div>
                <div class="streak-card">
                    <div class="streak-value">@StreakViewModel.CurrentStreak</div>
                    <div class="streak-label">CURRENT STREAK</div>
                </div>
                <div class="streak-card">
                    <div class="streak-value">@StreakViewModel.LongestStreak</div>
                    <div class="streak-label">LONGEST STREAK</div>
                </div>
                <div class="streak-card">
                    <div class="streak-value">@StreakViewModel.TotalWords</div>
                    <div class="streak-label">TOTAL WORDS</div>
                </div>
                <div class="streak-card">
                    <div class="streak-value">@StreakViewModel.AverageWords</div>
                    <div class="streak-label">AVERAGE WORDS</div>
                </div>
            </div>
        }
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
        <h2>Quick Actions</h2>
        <div class="action-buttons">
            <NavLink href="/editor" class="btn btn-primary btn-lg">
                Write Entry
            </NavLink>
            <NavLink href="/calendar" class="btn btn-outline-primary btn-lg">
                View Calendar
            </NavLink>
            <NavLink href="/search" class="btn btn-outline-primary btn-lg">
                Search Entries
            </NavLink>
            <NavLink href="/dashboard" class="btn btn-outline-primary btn-lg">
                Dashboard
            </NavLink>
            <NavLink href="/export" class="btn btn-outline-primary btn-lg">
                Export
            </NavLink>
        </div>
    </div>

    <!-- Recent Entries -->
    <div class="recent-entries">
        <h2>Recent Entries</h2>
        @if (HomeViewModel.IsLoading)
        {
            <p>Loading entries...</p>
        }
        else if (HomeViewModel.CurrentPageEntries.Any())
        {
            <div class="entry-list">
                @foreach (var entry in HomeViewModel.CurrentPageEntries)
                {
                    <div class="entry-item">
                        <div class="entry-date">@entry.EntryDate.ToString("MMMM dd, yyyy")</div>
                        @if (!string.IsNullOrEmpty(entry.Title))
                        {
                            <div class="entry-title">@entry.Title</div>
                        }
                        <div class="entry-preview">
                            @if (entry.Content.Length > 150)
                            {
                                <MarkdownView MarkdownText="@(entry.Content.Substring(0, 150) + "...")" />
                            }
                            else
                            {
                                <MarkdownView MarkdownText="@entry.Content" />
                            }
                        </div>
                        <div class="entry-actions">
                            <a href="/entry/date/@entry.EntryDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-primary">
                                View
                            </a>
                            <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirmation(entry)" type="button">
                                Delete
                            </button>
                            @if (HomeViewModel.IsTodayEntry(entry))
                            {
                                <a href="/editor/@entry.EntryDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
            
            <!-- Pagination Controls -->
            @if (HomeViewModel.TotalPages > 1)
            {
                <div class="pagination-controls">
                    <button class="btn btn-outline-primary" 
                            @onclick="HandlePreviousPage" 
                            disabled="@(!HomeViewModel.HasPreviousPage)">
                        Previous
                    </button>
                    <span class="page-info">Page @HomeViewModel.CurrentPage of @HomeViewModel.TotalPages</span>
                    <button class="btn btn-outline-primary" 
                            @onclick="HandleNextPage" 
                            disabled="@(!HomeViewModel.HasNextPage)">
                        Next
                    </button>
                </div>
            }
        }
        else
        {
            <p>No entries yet. <a href="/editor">Start writing your first entry!</a></p>
        }
    </div>
</div>

<DeleteConfirmation Show="@showDeleteDialog" 
                    Message="@deleteMessage"
                    OnConfirm="HandleConfirmDelete"
                    OnCancel="HandleCancelDelete" />

@if (showToast && !string.IsNullOrWhiteSpace(toastMessage))
{
    <div style="position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 2000; max-width: 420px;">
        <div class="alert @toastCssClass shadow" role="alert" style="margin: 0;">
            <div style="display: flex; align-items: start; justify-content: space-between; gap: 0.75rem;">
                <div>@toastMessage</div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HideToast"></button>
            </div>
        </div>
    </div>
}

@code {
    private bool showDeleteDialog = false;
    private JournalEntry? entryToDelete = null;
    private string deleteMessage = "Are you sure you want to delete this journal entry? This action cannot be undone.";
    private bool showToast = false;
    private string? toastMessage;
    private string toastCssClass = "alert-success";
    protected override async Task OnInitializedAsync()
    {
        System.Diagnostics.Debug.WriteLine("Home page: OnInitializedAsync");
        
        // Check if security is enabled and app is locked
        if (SecurityService.IsSecurityEnabled() && !SessionService.IsUnlocked())
        {
            System.Diagnostics.Debug.WriteLine("Security enabled and app is locked, redirecting to lock screen");
            Navigation.NavigateTo("/lock");
            return;
        }
        
        // Refresh session if unlocked
        if (SessionService.IsUnlocked())
        {
            SessionService.RefreshSession();
        }
        
        try
        {
            if (StreakViewModel?.LoadStreakStatsCommand != null)
            {
                await StreakViewModel.LoadStreakStatsCommand.ExecuteAsync(null);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"Error loading streak stats: {ex.Message}");
        }
        
        // Load entries with pagination
        if (HomeViewModel?.LoadEntriesCommand != null)
        {
            await HomeViewModel.LoadEntriesCommand.ExecuteAsync(null);
        }
    }

    private void HandleNextPage()
    {
        HomeViewModel?.NextPageCommand.Execute(null);
        StateHasChanged(); // Ensure UI updates
    }

    private void HandlePreviousPage()
    {
        HomeViewModel?.PreviousPageCommand.Execute(null);
        StateHasChanged(); // Ensure UI updates
    }

    private void ShowDeleteConfirmation(JournalEntry entry)
    {
        entryToDelete = entry;
        var dateStr = entry.EntryDate.ToString("MMMM dd, yyyy");
        deleteMessage = $"Are you sure you want to delete the journal entry from {dateStr}? This action cannot be undone.";
        showDeleteDialog = true;
        StateHasChanged();
    }

    private async Task HandleConfirmDelete()
    {
        showDeleteDialog = false;
        
        if (entryToDelete != null)
        {
            try
            {
                await HomeViewModel.DeleteEntryCommand.ExecuteAsync(entryToDelete.Id);
                
                // Reload entries and streak stats after deletion
                await HomeViewModel.LoadEntriesCommand.ExecuteAsync(null);
                await StreakViewModel.LoadStreakStatsCommand.ExecuteAsync(null);
                
                await ShowToastAsync("Journal entry deleted successfully.", isError: false);
            }
            catch (Exception ex)
            {
                await ShowToastAsync($"Error deleting entry: {ex.Message}", isError: true);
            }
        }
        
        entryToDelete = null;
        StateHasChanged();
    }

    private void HandleCancelDelete()
    {
        showDeleteDialog = false;
        entryToDelete = null;
        StateHasChanged();
    }

    private async Task ShowToastAsync(string message, bool isError)
    {
        toastMessage = message;
        toastCssClass = isError ? "alert-danger" : "alert-success";
        showToast = true;
        await InvokeAsync(StateHasChanged);

        // Auto-hide after 3 seconds
        await Task.Delay(3000);
        HideToast();
    }

    private void HideToast()
    {
        showToast = false;
        toastMessage = null;
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}
