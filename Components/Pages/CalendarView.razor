@page "/calendar"
@namespace Doodle.Components.Pages
@using Doodle.ViewModels
@using Doodle.Models
@inject CalendarViewModel ViewModel
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Calendar - Doodle</PageTitle>

<div class="calendar-container">
    <div class="calendar-header">
        <h2>Calendar View</h2>
        <div class="calendar-navigation">
            <button class="btn btn-outline-primary" @onclick="HandlePreviousMonth">
                ←
            </button>
            <button class="btn btn-outline-primary" @onclick="HandleToday">
                Today
            </button>
            <button class="btn btn-outline-primary" @onclick="HandleNextMonth">
                →
            </button>
        </div>
    </div>

    <div class="current-month">
        <h3>@ViewModel.CurrentMonth.ToString("MMMM yyyy")</h3>
    </div>

    @if (ViewModel.IsLoading)
    {
        <div class="text-center">
            <p>Loading calendar...</p>
        </div>
    }
    else
    {
        <!-- Calendar Grid -->
        <div class="calendar-grid">
            <!-- Day Headers -->
            <div class="calendar-day-header">Sun</div>
            <div class="calendar-day-header">Mon</div>
            <div class="calendar-day-header">Tue</div>
            <div class="calendar-day-header">Wed</div>
            <div class="calendar-day-header">Thu</div>
            <div class="calendar-day-header">Fri</div>
            <div class="calendar-day-header">Sat</div>

            <!-- Calendar Days -->
            @foreach (var day in GetCalendarDays())
            {
                var dayClass = GetDayClass(day);
                <div class="calendar-day @dayClass" @onclick="() => HandleDateClick(day)">
                    @day.Day
                </div>
            }
        </div>

        <!-- Selected Entry Preview -->
        @if (ViewModel.SelectedDate.HasValue)
        {
            <div class="entry-preview">
                <h4>Entry for @ViewModel.SelectedDate.Value.ToString("MMMM dd, yyyy")</h4>
                @if (ViewModel.SelectedEntry != null)
                {
                    <div class="entry-meta">
                        <span>Word Count: @ViewModel.SelectedEntry.WordCount</span>
                        <span>Updated: @ViewModel.SelectedEntry.UpdatedAt.ToString("g")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(ViewModel.SelectedEntry.Title))
                    {
                        <div class="entry-title">@ViewModel.SelectedEntry.Title</div>
                    }
                    <div class="entry-preview-text">
                        @(ViewModel.SelectedEntry.Content.Length > 200 
                            ? ViewModel.SelectedEntry.Content.Substring(0, 200) + "..." 
                            : ViewModel.SelectedEntry.Content)
                    </div>
                    <div style="margin-top: 1rem;">
                        <a href="/entry/date/@ViewModel.SelectedDate.Value.ToString("yyyy-MM-dd")" class="btn btn-primary">
                            View Entry
                        </a>
                        @if (ViewModel.SelectedDate.Value.Date == DateTime.Today)
                        {
                            <a href="/editor/@ViewModel.SelectedDate.Value.ToString("yyyy-MM-dd")" class="btn btn-outline-primary">
                                Edit Entry
                            </a>
                        }
                        else
                        {
                            <div class="alert alert-info" style="margin-top: 0.5rem; padding: 0.5rem 1rem; margin-bottom: 0;">
                                <small>This entry is read-only. Only today's entries can be edited.</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p>No entry for this date.</p>
                    @if (ViewModel.SelectedDate.Value.Date == DateTime.Today)
                    {
                        <a href="/editor/@ViewModel.SelectedDate.Value.ToString("yyyy-MM-dd")" class="btn btn-success">
                            Create Entry
                        </a>
                    }
                    else
                    {
                        <div class="alert alert-warning" style="margin-top: 0.5rem; padding: 0.5rem 1rem;">
                            <small>New entries can only be created for today's date (@DateTime.Today.ToString("MMMM dd, yyyy")).</small>
                        </div>
                    }
                }
            </div>
        }
    }
</div>

<!-- Toast Notification -->
@if (showToast && !string.IsNullOrWhiteSpace(toastMessage))
{
    <div style="position: fixed; right: 1.25rem; bottom: 1.25rem; z-index: 2000; max-width: 420px;">
        <div class="alert @toastCssClass shadow" role="alert" style="margin: 0;">
            <div style="display: flex; align-items: start; justify-content: space-between; gap: 0.75rem;">
                <div>@toastMessage</div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="HideToast"></button>
            </div>
        </div>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadEntryDatesCommand.ExecuteAsync(null);
    }

    private List<DateTime> GetCalendarDays()
    {
        var days = new List<DateTime>();
        var firstDayOfMonth = new DateTime(ViewModel.CurrentMonth.Year, ViewModel.CurrentMonth.Month, 1);
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

        // Start from the first day of the week that contains the first day of the month
        var startDate = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);
        
        // Generate 42 days (6 weeks) to fill the calendar grid
        for (int i = 0; i < 42; i++)
        {
            days.Add(startDate.AddDays(i));
        }

        return days;
    }

    private string GetDayClass(DateTime day)
    {
        var classes = new List<string>();

        // Check if day is in current month
        if (day.Month != ViewModel.CurrentMonth.Month)
        {
            classes.Add("other-month");
        }

        // Check if day is today
        if (day.Date == DateTime.Today)
        {
            classes.Add("today");
        }

        // Check if day has an entry
        if (ViewModel.HasEntry(day))
        {
            classes.Add("has-entry");
        }

        // Check if day is selected
        if (ViewModel.SelectedDate.HasValue && day.Date == ViewModel.SelectedDate.Value.Date)
        {
            classes.Add("selected");
        }

        return string.Join(" ", classes);
    }

    private async Task HandlePreviousMonth()
    {
        await ViewModel.NavigateToPreviousMonthCommand.ExecuteAsync(null);
    }

    private async Task HandleNextMonth()
    {
        await ViewModel.NavigateToNextMonthCommand.ExecuteAsync(null);
    }

    private async Task HandleToday()
    {
        await ViewModel.NavigateToTodayCommand.ExecuteAsync(null);
    }

    private async Task HandleDateClick(DateTime date)
    {
        // Check if it's a past date without entries
        if (date.Date < DateTime.Today && !ViewModel.HasEntry(date))
        {
            // Show toast message for past dates without entries
            await ShowToastAsync("Entries can only be made on present date.", isError: true);
            return;
        }

        // Check if the date has an entry
        if (ViewModel.HasEntry(date))
        {
            // Navigate to the entry view page for this date
            var dateString = date.ToString("yyyy-MM-dd");
            Navigation.NavigateTo($"/entry/date/{dateString}");
        }
        else
        {
            // If no entry, show the preview (current behavior)
            await ViewModel.SelectDateAsync(date);
        }
    }

    private bool showToast = false;
    private string? toastMessage;
    private string toastCssClass = "alert-success";

    private async Task ShowToastAsync(string message, bool isError)
    {
        toastMessage = message;
        toastCssClass = isError ? "alert-danger" : "alert-success";
        showToast = true;
        await InvokeAsync(StateHasChanged);

        // Auto-hide after 3 seconds
        await Task.Delay(3000);
        HideToast();
    }

    private void HideToast()
    {
        showToast = false;
        toastMessage = null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await Task.CompletedTask;
    }
}

