@page "/entry/{EntryId:int}"
@page "/entry/date/{EntryDate:datetime}"
@namespace Doodle.Components.Pages
@using Doodle.ViewModels
@using Doodle.Components.Shared
@inject ViewJournalEntryViewModel ViewModel
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Journal Entry - Doodle</PageTitle>

<div class="view-entry-container">
    @if (ViewModel.IsLoading)
    {
        <div class="text-center">
            <p>Loading entry...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ViewModel.ErrorMessage
        </div>
        <div class="mt-3">
            <a href="/" class="btn btn-primary">Return to Home</a>
        </div>
    }
    else if (ViewModel.Entry == null)
    {
        <div class="alert alert-info" role="alert">
            Entry not found.
        </div>
        <div class="mt-3">
            <a href="/" class="btn btn-primary">Return to Home</a>
        </div>
    }
    else
    {
        <div class="entry-header">
            <div class="entry-actions">
                @if (ViewModel.IsTodayEntry)
                {
                    <a href="/editor/@ViewModel.Entry.EntryDate.ToString("yyyy-MM-dd")" class="btn btn-primary">
                        Edit Entry
                    </a>
                }
                else
                {
                    <div class="alert alert-info" style="margin-bottom: 0; padding: 0.5rem 1rem;">
                        <small>This entry is read-only. Only today's entries can be edited.</small>
                    </div>
                }
                <a href="/" class="btn btn-outline-secondary">Back to Home</a>
            </div>
        </div>

        <div class="entry-content">
            <!-- Entry Date -->
            <div class="entry-meta">
                <h1 class="entry-date">@ViewModel.Entry.EntryDate.ToString("MMMM dd, yyyy")</h1>
                <div class="entry-timestamps">
                    <small class="text-muted">
                        Created: @ViewModel.Entry.CreatedAt.ToString("g") | 
                        Updated: @ViewModel.Entry.UpdatedAt.ToString("g")
                    </small>
                </div>
            </div>

            <!-- Title -->
            @if (!string.IsNullOrEmpty(ViewModel.Entry.Title))
            {
                <h2 class="entry-title">@ViewModel.Entry.Title</h2>
            }

            <!-- Moods -->
            <div class="entry-moods">
                @if (ViewModel.PrimaryMood != null)
                {
                    <div class="mood-badge mood-primary">
                        <strong>Primary Mood:</strong> @ViewModel.PrimaryMood.Name
                        @if (!string.IsNullOrEmpty(ViewModel.PrimaryMood.Category))
                        {
                            <span class="mood-category">(@ViewModel.PrimaryMood.Category)</span>
                        }
                    </div>
                }
                @if (ViewModel.SecondaryMoods.Any())
                {
                    <div class="mood-badge mood-secondary">
                        <strong>Secondary Moods:</strong>
                        @foreach (var mood in ViewModel.SecondaryMoods)
                        {
                            <span>@mood.Name</span>
                            @if (mood != ViewModel.SecondaryMoods.Last())
                            {
                                <span>, </span>
                            }
                        }
                    </div>
                }
            </div>

            <!-- Category -->
            @if (!string.IsNullOrEmpty(ViewModel.Entry.Category))
            {
                <div class="entry-category">
                    <strong>Category:</strong>
                    <span class="category-badge">@ViewModel.Entry.Category</span>
                </div>
            }

            <!-- Tags -->
            @if (ViewModel.Tags.Any())
            {
                <div class="entry-tags">
                    <strong>Tags:</strong>
                    @foreach (var tag in ViewModel.Tags)
                    {
                        <span class="tag-badge">@tag.Name</span>
                    }
                </div>
            }

            <!-- Content -->
            <div class="entry-body">
                <MarkdownView MarkdownText="@ViewModel.Entry.Content" />
            </div>

            <!-- Entry Statistics -->
            <div class="entry-stats">
                <div class="stat-item">
                    <strong>Word Count:</strong> @ViewModel.Entry.WordCount
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? EntryId { get; set; }

    [Parameter]
    public DateTime? EntryDate { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (EntryId.HasValue)
        {
            await ViewModel.LoadEntryCommand.ExecuteAsync(EntryId.Value);
        }
        else if (EntryDate.HasValue)
        {
            await ViewModel.LoadEntryByDateCommand.ExecuteAsync(EntryDate.Value);
        }
        else
        {
            Navigation.NavigateTo("/");
        }
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}
