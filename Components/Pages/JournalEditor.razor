@page "/editor"
@page "/editor/{SelectedDate:datetime}"
@namespace Doodle.Components.Pages
@using Doodle.ViewModels
@using Doodle.Models
@using Doodle.Components.Shared
@inject JournalEditorViewModel ViewModel
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<PageTitle>Journal Editor - Doodle</PageTitle>

<div class="journal-editor-container">
    <div class="editor-header">
        <h2>Journal Entry</h2>
        <div class="date-selector">
            <label>Date:</label>
            <input type="date" @bind="ViewModel.SelectedDate" @bind:event="onchange" 
                   class="form-control" style="display: inline-block; width: auto;"
                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            <button class="btn btn-primary" @onclick="HandleLoadEntry">
                Load
            </button>
            @if (ViewModel.SelectedDate.Date != DateTime.Today)
            {
                <div class="alert alert-warning" style="margin-top: 0.5rem; padding: 0.5rem 1rem;">
                    <small>Only today's date (@DateTime.Today.ToString("MMMM dd, yyyy")) can be used for journal entries.</small>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ViewModel.ErrorMessage
        </div>
    }

    @if (ViewModel.IsLoading)
    {
        <div class="text-center">
            <p>Loading...</p>
        </div>
    }
    else
    {
        <div class="editor-content">
            <!-- Title Input -->
            <div class="form-group">
                <label for="entry-title">Title (Optional)</label>
                <input type="text" id="entry-title" class="form-control" 
                       @bind="ViewModel.Title" placeholder="Give your entry a title..." />
            </div>

            <!-- Word Count Display -->
            <div class="word-count">
                <strong>Word Count:</strong> @ViewModel.WordCount
            </div>

            <!-- Content Editor with Split View -->
            <div class="editor-split">
                <!-- Markdown Editor -->
                <div class="editor-panel">
                    <div class="editor-label-with-toolbar">
                        <label for="entry-content">Content</label>
                        <div class="formatting-toolbar">
                            <button type="button" class="format-btn" title="Bold" @onclick="HandleFormatBold">
                                <strong>B</strong>
                            </button>
                            <button type="button" class="format-btn" title="Italic" @onclick="HandleFormatItalic">
                                <em>I</em>
                            </button>
                            <button type="button" class="format-btn" title="Underline" @onclick="HandleFormatUnderline">
                                <u>U</u>
                            </button>
                            <button type="button" class="format-btn" title="Code" @onclick="HandleFormatCode">
                                <code>&lt;/&gt;</code>
                            </button>
                            <button type="button" class="format-btn" title="Bullet List" @onclick="HandleFormatBulletList">
                                •
                            </button>
                            <button type="button" class="format-btn" title="Numbered List" @onclick="HandleFormatNumberedList">
                                1.
                            </button>
                            <button type="button" class="format-btn" title="Link" @onclick="HandleFormatLink">
                                🔗
                            </button>
                        </div>
                    </div>
                    <textarea id="entry-content" class="form-control markdown-editor" 
                              @bind="ViewModel.Content"
                              @bind:event="oninput"
                              placeholder="Write your thoughts here... Markdown is supported!&#10;&#10;Examples:&#10;# Heading&#10;**Bold text**&#10;*Italic text*&#10;- List item&#10;[Link text](https://example.com)"></textarea>
                </div>

                <!-- Live Preview -->
                <div class="preview-panel">
                    <label>Live Preview</label>
                    <div class="preview-content">
                        <MarkdownView MarkdownText="@ViewModel.Content" />
                    </div>
                </div>
            </div>

            <!-- Mood Selection -->
            <div class="mood-section">
                <h3>Moods</h3>
                
                <!-- Primary Mood (Required) -->
                <div class="form-group">
                    <label>Primary Mood <span class="required">*</span></label>
                    <select class="form-control" @bind="ViewModel.SelectedPrimaryMoodId">
                        <option value="">-- Select Primary Mood --</option>
                        @foreach (var mood in ViewModel.AvailableMoods.GroupBy(m => m.Category))
                        {
                            <optgroup label="@mood.Key">
                                @foreach (var m in mood)
                                {
                                    <option value="@m.Id">@m.Icon @m.Name</option>
                                }
                            </optgroup>
                        }
                    </select>
                </div>

                <!-- Secondary Moods (Optional, max 2) -->
                <div class="form-group">
                    <label>Secondary Moods (Optional, up to 2)</label>
                    <div class="mood-buttons">
                        @foreach (var mood in ViewModel.AvailableMoods.Where(m => m.Id != ViewModel.SelectedPrimaryMoodId))
                        {
                            var isSelected = ViewModel.SelectedSecondaryMoods.Any(m => m.Id == mood.Id);
                            var isDisabled = !isSelected && ViewModel.SelectedSecondaryMoods.Count >= 2;
                            <button type="button" 
                                    class="btn @(isSelected ? "btn-primary" : "btn-outline-secondary")"
                                    disabled="@isDisabled"
                                    @onclick="() => ToggleSecondaryMood(mood)">
                                @mood.Icon @mood.Name
                            </button>
                        }
                    </div>
                    @if (ViewModel.SelectedSecondaryMoods.Any())
                    {
                        <div class="selected-secondary-moods">
                            <strong>Selected:</strong>
                            @foreach (var mood in ViewModel.SelectedSecondaryMoods)
                            {
                                <span class="badge badge-primary">
                                    @mood.Icon @mood.Name
                                    <button type="button" class="btn-close" @onclick="() => ViewModel.RemoveSecondaryMood(mood)">×</button>
                                </span>
                            }
                        </div>
                    }
                </div>

                <!-- Add New Mood -->
                <div style="margin-top: 0.75rem; padding: 0.75rem; background: rgba(0, 0, 0, 0.02); border-radius: 8px; border: 1px solid rgba(0, 0, 0, 0.1);">
                    <label style="font-weight: 500; margin-bottom: 0.5rem; display: block;">Add New Mood:</label>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
                        <input type="text" class="form-control" style="flex: 1; min-width: 120px; max-width: 150px;" 
                               @bind="ViewModel.NewMoodName" 
                               @bind:event="oninput"
                               placeholder="Mood name..." />
                        <input type="text" class="form-control" style="width: 80px;" 
                               @bind="ViewModel.NewMoodIcon" 
                               @bind:event="oninput"
                               placeholder="Icon/Emoji" 
                               maxlength="5" />
                        <select class="form-control" style="width: 120px;" @bind="ViewModel.NewMoodCategory">
                            <option value="Positive">Positive</option>
                            <option value="Neutral">Neutral</option>
                            <option value="Negative">Negative</option>
                        </select>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="HandleCreateMood">
                            + Add Mood
                        </button>
                    </div>
                </div>
            </div>

            <!-- Category Selection -->
            <div class="form-group">
                <label for="entry-category">Category (Optional)</label>
                <select id="entry-category" class="form-control" @bind="ViewModel.SelectedCategory">
                    <option value="">-- No Category --</option>
                    @foreach (var category in ViewModel.AvailableCategories)
                    {
                        <option value="@category.Name">@category.Name</option>
                    }
                </select>
                <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem; align-items: center;">
                    <input type="text" class="form-control" style="flex: 1; max-width: 200px;" 
                           @bind="ViewModel.NewCategoryName" 
                           @bind:event="oninput"
                           placeholder="New category name..." 
                           @onkeypress="@((KeyboardEventArgs e) => { if (e.Key == "Enter") HandleCreateCategory(); })" />
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="HandleCreateCategory">
                        + Add Category
                    </button>
                </div>
            </div>

            <!-- Tag Selection -->
            <div class="tag-section">
                <h3>Tags</h3>
                <div class="tag-buttons">
                    @foreach (var tag in ViewModel.AvailableTags)
                    {
                        var isSelected = ViewModel.SelectedTags.Contains(tag);
                        <button type="button" 
                                class="btn @(isSelected ? "btn-success" : "btn-outline-secondary")"
                                @onclick="() => ViewModel.ToggleTag(tag)">
                            @tag.Name
                        </button>
                    }
                </div>
                @if (ViewModel.SelectedTags.Any())
                {
                    <div class="selected-tags">
                        <strong>Selected Tags:</strong>
                        @foreach (var tag in ViewModel.SelectedTags)
                        {
                            <span class="badge badge-success" style="background-color: @(tag.Color ?? "#28a745");">
                                @tag.Name
                            </span>
                        }
                    </div>
                }
                <div style="margin-top: 0.75rem; display: flex; gap: 0.5rem; align-items: center;">
                    <input type="text" class="form-control" style="flex: 1; max-width: 200px;" 
                           @bind="ViewModel.NewTagName" 
                           @bind:event="oninput"
                           placeholder="New tag name..." 
                           @onkeypress="@((KeyboardEventArgs e) => { if (e.Key == "Enter") HandleCreateTag(); })" />
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="HandleCreateTag">
                        + Add Tag
                    </button>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="editor-actions">
                <button class="btn btn-success" @onclick="HandleSaveEntry" 
                        disabled="@ViewModel.IsLoading">
                    @(ViewModel.IsEditMode ? "Update Entry" : "Create Entry")
                </button>
                @if (ViewModel.IsEditMode)
                {
                    <button class="btn btn-danger" @onclick="ShowDeleteConfirmation" 
                            disabled="@ViewModel.IsLoading">
                        Delete Entry
                    </button>
                }
            </div>
        </div>
    }
</div>

<DeleteConfirmation Show="@showDeleteDialog" 
                    Message="Are you sure you want to delete this journal entry? This action cannot be undone."
                    OnConfirm="HandleConfirmDelete"
                    OnCancel="HandleCancelDelete" />

@code {
    private bool showDeleteDialog = false;

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.LoadEntryForDateCommand.ExecuteAsync(null);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (SelectedDate != default)
        {
            ViewModel.SelectedDate = SelectedDate;
            await ViewModel.LoadEntryForDateCommand.ExecuteAsync(null);
        }
    }

    private void ToggleSecondaryMood(Mood mood)
    {
        if (ViewModel.SelectedSecondaryMoods.Any(m => m.Id == mood.Id))
        {
            var moodToRemove = ViewModel.SelectedSecondaryMoods.FirstOrDefault(m => m.Id == mood.Id);
            if (moodToRemove != null)
            {
                ViewModel.RemoveSecondaryMood(moodToRemove);
            }
        }
        else
        {
            ViewModel.AddSecondaryMood(mood);
        }
    }

    private void ShowDeleteConfirmation()
    {
        showDeleteDialog = true;
    }

    private async Task HandleConfirmDelete()
    {
        showDeleteDialog = false;
        await ViewModel.DeleteEntryCommand.ExecuteAsync(null);
    }

    private void HandleCancelDelete()
    {
        showDeleteDialog = false;
    }

    private async Task HandleLoadEntry()
    {
        await ViewModel.LoadEntryForDateCommand.ExecuteAsync(null);
    }

    private async Task HandleSaveEntry()
    {
        await ViewModel.SaveEntryCommand.ExecuteAsync(null);
    }

    private async Task HandleFormatBold()
    {
        await ViewModel.FormatBoldCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleFormatItalic()
    {
        await ViewModel.FormatItalicCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleFormatUnderline()
    {
        await ViewModel.FormatUnderlineCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleFormatCode()
    {
        await ViewModel.FormatCodeCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleFormatBulletList()
    {
        await ViewModel.FormatBulletListCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleFormatNumberedList()
    {
        await ViewModel.FormatNumberedListCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleFormatLink()
    {
        await ViewModel.FormatLinkCommand.ExecuteAsync(JSRuntime);
    }

    private async Task HandleCreateTag()
    {
        await ViewModel.CreateTagCommand.ExecuteAsync(null);
        StateHasChanged();
    }

    private async Task HandleCreateCategory()
    {
        await ViewModel.CreateCategoryCommand.ExecuteAsync(null);
        StateHasChanged();
    }

    private async Task HandleCreateMood()
    {
        await ViewModel.CreateMoodCommand.ExecuteAsync(null);
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }

    [Parameter]
    public DateTime SelectedDate { get; set; }
}

